{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "home" : {
        "ClusterId": "home",
        "Order": 100,
        "Match": {
          "Path": "/{**catch-all}"
        }
      },
      "route1" : {
        "ClusterId": "kepler90",
        "Match": {
          "Path": "/kepler90/{**remainder}"
        }
      },
      "route2" : {
        "ClusterId": "proximaCentauri",
        "Match": {
          "Path": "/proximaCentauri/{**remainder}"
        }
      },
      "route3" : {
        "ClusterId": "trappist1",
        "Match": {
          "Path": "/trappist1/{**remainder}"
        }
      }
    },
    "Clusters": {
      "home": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8084"
          }
        }
      },
      "kepler90": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8081"
          }
        }
      },
      "proximaCentauri": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8082"
          }
        }
      },
      "trappist1": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8083"
          }
        }
      }
    }
  }
}

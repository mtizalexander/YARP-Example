{
    "version": "2.0.0",
	"tasks": [
		{
			"label": "Start OtelServer",
			"type": "shell",
			"command": "pwsh ./Start-OtelServer.ps1 -NonInteractive -ExecutionPolicy Bypass",
			"options": {
				"cwd": "${workspaceFolder}/Tools"
			},
			"isBackground": true,
		},
		{
			"label": "Build Solution",
			"type": "shell",
			"command": "dotnet build StarMap.slnx",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$msCompile"
		}
	]
}